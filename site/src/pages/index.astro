---
const checks = [
  { label: "Java content engine", status: "scaffolded" },
  { label: "Astro frontend", status: "scaffolded" },
  { label: "GitHub Pages workflow", status: "ready to test" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Learn Modern Java</title>
    <style>
      :root {
        color-scheme: light;
        --ink: #17202a;
        --muted: #5e6b76;
        --line: #d8dee4;
        --panel: #f6f8fa;
        --accent: #0b6bcb;
        --accent-soft: #dbeafe;
        --ok: #1f7a4d;
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
          sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--ink);
        background: #ffffff;
      }

      main {
        width: min(1040px, calc(100% - 32px));
        margin: 0 auto;
        padding: 56px 0;
      }

      .masthead {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(280px, 380px);
        gap: 32px;
        align-items: center;
        border-bottom: 1px solid var(--line);
        padding-bottom: 40px;
      }

      h1 {
        margin: 0;
        max-width: 780px;
        font-size: clamp(2.5rem, 8vw, 5rem);
        line-height: 0.96;
        letter-spacing: 0;
      }

      .summary {
        max-width: 680px;
        margin: 20px 0 0;
        color: var(--muted);
        font-size: 1.1rem;
        line-height: 1.65;
      }

      .diagram {
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--panel);
        padding: 20px;
      }

      .flow {
        display: grid;
        gap: 10px;
      }

      .node {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: #ffffff;
        padding: 12px 14px;
        font-size: 0.95rem;
      }

      .node strong {
        font-weight: 700;
      }

      .node span {
        color: var(--muted);
      }

      .arrow {
        color: var(--accent);
        text-align: center;
        font-weight: 700;
      }

      .status-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-top: 28px;
      }

      .status {
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 18px;
      }

      .status span {
        display: inline-flex;
        width: fit-content;
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--accent);
        padding: 4px 10px;
        font-size: 0.8rem;
        font-weight: 700;
      }

      .status h2 {
        margin: 14px 0 0;
        font-size: 1rem;
      }

      .next {
        margin-top: 32px;
        color: var(--muted);
        line-height: 1.6;
      }

      .ok {
        color: var(--ok);
        font-weight: 700;
      }

      @media (max-width: 760px) {
        main {
          width: min(100% - 24px, 1040px);
          padding: 32px 0;
        }

        .masthead,
        .status-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <section class="masthead">
        <div>
          <p class="ok">Deploy test</p>
          <h1>Learn Modern Java</h1>
          <p class="summary">
            A Java 26 content engine and Astro frontend for learning modern Java features
            from official OpenJDK JEPs.
          </p>
        </div>

        <aside class="diagram" aria-label="Project architecture">
          <div class="flow">
            <div class="node"><strong>OpenJDK JEPs</strong><span>source</span></div>
            <div class="arrow">v</div>
            <div class="node"><strong>Java engine</strong><span>parse</span></div>
            <div class="arrow">v</div>
            <div class="node"><strong>Generated JSON</strong><span>contract</span></div>
            <div class="arrow">v</div>
            <div class="node"><strong>Astro site</strong><span>render</span></div>
          </div>
        </aside>
      </section>

      <section class="status-grid" aria-label="Scaffold status">
        {
          checks.map((check) => (
            <article class="status">
              <span>{check.status}</span>
              <h2>{check.label}</h2>
            </article>
          ))
        }
      </section>

      <p class="next">
        This page exists to verify that the project scaffold, dependency setup, and GitHub
        Pages deployment path are working before the first JEP ingestion slice begins.
      </p>
    </main>
  </body>
</html>
